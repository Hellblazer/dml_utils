# Benchmark configuration.
#
# Sourced by the benchmark scripts (setup.sh, run.sh, report.sh, psql.sh). Every
# value can be overridden in the environment for a one-off run, or edited here to
# make a different sweep the default. Keep this file in step with the results you
# publish: the report records the values it ran with.
#
# This file only sets defaults. It does not derive or validate anything, because
# config.local.env is sourced *after* it: a check or a derived value computed here
# would ignore a personal override (for example BENCH_PK_COLUMNS=3). Each script
# calls bench_derive and bench_validate once both files are loaded.
#
# The benchmark uses a DEDICATED PostgreSQL container (not the shared dev stack)
# so the server settings that a reproducible run needs -- above all
# max_worker_processes, which must be >= the thread count -- can be set without
# touching the dev database.

# --- Database server --------------------------------------------------------
# The custom image (roles + plpgsql_check + pg_background). Build it with
# scripts/build-postgres-image.sh postgres:17-alpine if it is missing.
BENCH_IMAGE="${BENCH_IMAGE:-dml-utils-postgres:17-alpine}"
BENCH_LIQUIBASE_IMAGE="${BENCH_LIQUIBASE_IMAGE:-liquibase/liquibase:5.0.4}"
BENCH_CONTAINER="${BENCH_CONTAINER:-dml_utils_benchmark_pg}"
BENCH_VOLUME="${BENCH_VOLUME:-dml_utils_benchmark_pgdata}"
BENCH_NETWORK="${BENCH_NETWORK:-dml_utils_benchmark_net}"

# The image's init script connects to the project database (dml_utils), so the
# database name is fixed; the container is what isolates the benchmark.
BENCH_DB="${BENCH_DB:-dml_utils}"
BENCH_DB_USER="${BENCH_DB_USER:-postgres}"
BENCH_OWNER_USER="${BENCH_OWNER_USER:-dml_utils_owner}"
# Well-known, non-secret default for the disposable local container (loopback
# only). Override it in config.local.env if the benchmark database is ever
# reachable by anything else.
BENCH_OWNER_PASSWORD="${BENCH_OWNER_PASSWORD:-dml_utils_owner}"

# Optional: publish this loopback port for inspection with your own client. The
# scripts talk to the container through `docker exec`, so the default is empty
# (nothing is published), which also lets concurrent benchmark stacks coexist.
BENCH_HOST_PORT="${BENCH_HOST_PORT:-}"

# Server settings. max_worker_processes must be at least BENCH_THREADS_TO, with
# headroom for autovacuum and other background workers; changing it requires
# recreating the container (setup.sh --refresh).
BENCH_MAX_WORKER_PROCESSES="${BENCH_MAX_WORKER_PROCESSES:-30}"
BENCH_SHARED_BUFFERS="${BENCH_SHARED_BUFFERS:-512MB}"
BENCH_MAX_CONNECTIONS="${BENCH_MAX_CONNECTIONS:-100}"

# --- Dataset ----------------------------------------------------------------
BENCH_SCHEMA="${BENCH_SCHEMA:-benchmark}"
BENCH_SOURCE_TABLE="${BENCH_SOURCE_TABLE:-bench_source}"
BENCH_TARGET_TABLE="${BENCH_TARGET_TABLE:-bench_target}"
# The ordered_key variant uses its own UUIDv4-keyed source and target, with a
# (created_at, id) unique index, so its results are comparable with the
# bigint-keyed primary_key and blocks runs.
BENCH_ORDERED_SOURCE_TABLE="${BENCH_ORDERED_SOURCE_TABLE:-bench_ordered_source}"
BENCH_ORDERED_TARGET_TABLE="${BENCH_ORDERED_TARGET_TABLE:-bench_ordered_target}"
BENCH_ORDERED_INDEX="${BENCH_ORDERED_INDEX:-bench_ordered_created_at_id_idx}"
# The partition-wise variant uses a range-partitioned copy of the bigint-keyed
# source with BENCH_PARTITIONED_LEAVES leaves, plus its own throwaway target.
# The leaf count must not exceed the number of distinct k1 values: BENCH_ROWS for
# a one-column key, otherwise ceil(BENCH_ROWS / m^(columns-1)) where m is the
# smallest value with m^columns >= BENCH_ROWS (setup.sh checks it).
BENCH_PARTITIONED_SOURCE_TABLE="${BENCH_PARTITIONED_SOURCE_TABLE:-bench_partitioned_source}"
BENCH_PARTITIONED_TARGET_TABLE="${BENCH_PARTITIONED_TARGET_TABLE:-bench_partitioned_target}"
BENCH_PARTITIONED_LEAVES="${BENCH_PARTITIONED_LEAVES:-4}"
# The partition-wise ordered_key variant uses a hash-partitioned copy of the
# UUIDv4-keyed ordered fixture, with its own (created_at, id) unique index and
# throwaway target.
BENCH_PARTITIONED_ORDERED_SOURCE_TABLE="${BENCH_PARTITIONED_ORDERED_SOURCE_TABLE:-bench_partitioned_ordered_source}"
BENCH_PARTITIONED_ORDERED_TARGET_TABLE="${BENCH_PARTITIONED_ORDERED_TARGET_TABLE:-bench_partitioned_ordered_target}"
BENCH_PARTITIONED_ORDERED_INDEX="${BENCH_PARTITIONED_ORDERED_INDEX:-bench_partitioned_ordered_created_at_id_idx}"
# Source rows. The data is deterministic: row N always has the same key tuple
# and payload, so a refresh reproduces the table exactly.
BENCH_ROWS="${BENCH_ROWS:-1000000}"
# The number of primary-key columns of the driving table, all bigint: 1, 2 or 3
# (matching the chunking engine). The source and target tables are created with
# columns k1..kN.
BENCH_PK_COLUMNS="${BENCH_PK_COLUMNS:-1}"

# Chunk size, in the unit of BENCH_CHUNK_BY: source rows for primary_key and
# ordered_key, heap blocks for blocks.
BENCH_CHUNK_SIZE="${BENCH_CHUNK_SIZE:-1000}"
# The chunking strategy: primary_key (fixed rows in primary-key order, the
# default), ordered_key (fixed rows in the order of BENCH_ORDERED_INDEX) or
# blocks (physical heap block ranges). blocks requires a quiescent, read-only
# source, which the default INSERT-into-target workload satisfies.
BENCH_CHUNK_BY="${BENCH_CHUNK_BY:-primary_key}"
# The partition-wise modifier runs the configured strategy inside each leaf of a
# partitioned fixture: the range-partitioned bigint copy for primary_key/blocks,
# or the hash-partitioned UUID copy for ordered_key.
BENCH_PARTITION_WISE="${BENCH_PARTITION_WISE:-0}"

# The SQL template run once per chunk. It must contain <driving_table> and
# <chunking_clause> exactly once; the driving table is aliased `t`. The identifiers
# are quoted with double quotes (they are allowlisted by bench_validate), so a
# reserved word or a name that needs quoting cannot produce invalid SQL. The
# default copies the chunk's rows into a throwaway target, so the source table is
# never modified and each run starts from the same state.
# BENCH_SQL, BENCH_PARTITIONED_SQL, BENCH_ORDERED_SQL and
# BENCH_PARTITIONED_ORDERED_SQL are built by bench_derive (below) so that a
# BENCH_PK_COLUMNS override from config.local.env is reflected in them.

# --- Sweep ------------------------------------------------------------------
BENCH_THREADS_FROM="${BENCH_THREADS_FROM:-1}"
BENCH_THREADS_TO="${BENCH_THREADS_TO:-20}"
# Measured runs per thread value; the mean is taken over these.
BENCH_RUNS="${BENCH_RUNS:-10}"
# Unrecorded warm-up runs per thread value, to page in the table and warm the
# caches before measuring.
BENCH_WARMUP_RUNS="${BENCH_WARMUP_RUNS:-1}"
# Truncate the target table before every run so the INSERT does not accumulate.
# Only 0 and 1 are accepted: a typo must fail loudly instead of silently leaving
# the target to accumulate across runs and skew the timings.
BENCH_TRUNCATE_TARGET="${BENCH_TRUNCATE_TARGET:-1}"

# --- Output -----------------------------------------------------------------
BENCH_RESULTS_DIR="${BENCH_RESULTS_DIR:-results}"
BENCH_CSV="${BENCH_CSV:-benchmark.csv}"
BENCH_REPORT="${BENCH_REPORT:-report.md}"

# --- Derived values and validation -----------------------------------------
# Call these after config.local.env is sourced, never from this file itself.
# They return non-zero instead of exiting, so sourcing config.env in an
# interactive shell cannot kill it.

# Builds the key-column lists and the default workload SQL for the effective
# BENCH_PK_COLUMNS. Idempotent; a template set by the environment or by
# config.local.env wins over the derived default.
bench_derive() {
    BENCH_PK_COLS_CSV=""
    BENCH_PK_SELECT=""
    _bench_pk_i=0
    while [ "$_bench_pk_i" -lt "$BENCH_PK_COLUMNS" ]; do
        _bench_pk_i=$((_bench_pk_i + 1))
        BENCH_PK_COLS_CSV="${BENCH_PK_COLS_CSV:+$BENCH_PK_COLS_CSV, }k$_bench_pk_i"
        BENCH_PK_SELECT="${BENCH_PK_SELECT:+$BENCH_PK_SELECT, }t.k$_bench_pk_i"
    done
    unset _bench_pk_i

    : "${BENCH_SQL:=INSERT INTO \"${BENCH_SCHEMA}\".\"${BENCH_TARGET_TABLE}\" (${BENCH_PK_COLS_CSV}, payload) SELECT ${BENCH_PK_SELECT}, t.payload FROM <driving_table> WHERE <chunking_clause>}"
    : "${BENCH_PARTITIONED_SQL:=INSERT INTO \"${BENCH_SCHEMA}\".\"${BENCH_PARTITIONED_TARGET_TABLE}\" (${BENCH_PK_COLS_CSV}, payload) SELECT ${BENCH_PK_SELECT}, t.payload FROM <driving_table> WHERE <chunking_clause>}"
    : "${BENCH_ORDERED_SQL:=INSERT INTO \"${BENCH_SCHEMA}\".\"${BENCH_ORDERED_TARGET_TABLE}\" (id, created_at, payload) SELECT t.id, t.created_at, t.payload FROM <driving_table> WHERE <chunking_clause>}"
    : "${BENCH_PARTITIONED_ORDERED_SQL:=INSERT INTO \"${BENCH_SCHEMA}\".\"${BENCH_PARTITIONED_ORDERED_TARGET_TABLE}\" (id, created_at, payload) SELECT t.id, t.created_at, t.payload FROM <driving_table> WHERE <chunking_clause>}"
}

bench_fail() {
    echo "benchmark configuration: $*" >&2
    _bench_invalid=1
}

# $1 = setting name, $2 = value, $3 = minimum
bench_require_integer() {
    case "$2" in
        ''|*[!0-9]*)
            bench_fail "$1 must be an integer: '$2'"
            return
            ;;
    esac
    [ "$2" -ge "$3" ] || bench_fail "$1 must be at least $3: $2"
}

bench_require_identifier() {
    case "$2" in
        ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*)
            bench_fail "$1 must be an unquoted identifier (letters, digits and _, not starting with a digit): '$2'"
            ;;
    esac
}

# $1 = setting name, $2 = template
bench_require_template() {
    _bench_template="$2"
    _bench_count=0
    while :; do
        case "$_bench_template" in
            *"<driving_table>"*)
                _bench_count=$((_bench_count + 1))
                _bench_template="${_bench_template#*<driving_table>}"
                ;;
            *) break ;;
        esac
    done
    [ "$_bench_count" -eq 1 ] \
        || bench_fail "$1 must contain <driving_table> exactly once (found $_bench_count)"

    _bench_template="$2"
    _bench_count=0
    while :; do
        case "$_bench_template" in
            *"<chunking_clause>"*)
                _bench_count=$((_bench_count + 1))
                _bench_template="${_bench_template#*<chunking_clause>}"
                ;;
            *) break ;;
        esac
    done
    [ "$_bench_count" -eq 1 ] \
        || bench_fail "$1 must contain <chunking_clause> exactly once (found $_bench_count)"
}

# Validates the effective configuration. Returns non-zero when anything is
# wrong, after reporting every problem, so a typo fails before any DDL or
# measurement instead of deep inside a run.
bench_validate() {
    _bench_invalid=0

    case "$BENCH_PK_COLUMNS" in
        1|2|3) ;;
        *) bench_fail "BENCH_PK_COLUMNS must be 1, 2 or 3: $BENCH_PK_COLUMNS" ;;
    esac
    bench_require_integer BENCH_ROWS "$BENCH_ROWS" 1
    case "$BENCH_ROWS" in
        ''|*[!0-9]*) ;;
        *)
            [ "$BENCH_ROWS" -le 9007199254740991 ] \
                || bench_fail "BENCH_ROWS must be below 2^53 so the integer key derivation stays exact: $BENCH_ROWS"
            ;;
    esac
    bench_require_integer BENCH_CHUNK_SIZE "$BENCH_CHUNK_SIZE" 1
    bench_require_integer BENCH_THREADS_FROM "$BENCH_THREADS_FROM" 1
    bench_require_integer BENCH_THREADS_TO "$BENCH_THREADS_TO" 1
    bench_require_integer BENCH_RUNS "$BENCH_RUNS" 1
    bench_require_integer BENCH_WARMUP_RUNS "$BENCH_WARMUP_RUNS" 0
    bench_require_integer BENCH_MAX_WORKER_PROCESSES "$BENCH_MAX_WORKER_PROCESSES" 1
    bench_require_integer BENCH_MAX_CONNECTIONS "$BENCH_MAX_CONNECTIONS" 1
    bench_require_integer BENCH_PARTITIONED_LEAVES "$BENCH_PARTITIONED_LEAVES" 1
    if [ -n "$BENCH_HOST_PORT" ]; then
        bench_require_integer BENCH_HOST_PORT "$BENCH_HOST_PORT" 1
    fi

    case "$BENCH_CHUNK_BY" in
        primary_key|ordered_key|blocks) ;;
        *) bench_fail "BENCH_CHUNK_BY must be primary_key, ordered_key or blocks: $BENCH_CHUNK_BY" ;;
    esac
    case "$BENCH_TRUNCATE_TARGET" in
        0|1) ;;
        *) bench_fail "BENCH_TRUNCATE_TARGET must be 0 or 1: $BENCH_TRUNCATE_TARGET" ;;
    esac
    case "$BENCH_PARTITION_WISE" in
        0|1|no|yes|false|true) ;;
        *) bench_fail "BENCH_PARTITION_WISE must be 0/1 (or yes/no): $BENCH_PARTITION_WISE" ;;
    esac

    # Cross-field checks. Only compare once both values are known integers, so a
    # bad value is reported once (above) instead of also raising an arithmetic
    # error here.
    case "$BENCH_THREADS_FROM$BENCH_THREADS_TO" in
        *[!0-9]*) ;;
        *)
            [ "$BENCH_THREADS_FROM" -le "$BENCH_THREADS_TO" ] \
                || bench_fail "BENCH_THREADS_FROM ($BENCH_THREADS_FROM) must not exceed BENCH_THREADS_TO ($BENCH_THREADS_TO)"
            ;;
    esac
    case "$BENCH_MAX_WORKER_PROCESSES$BENCH_THREADS_TO" in
        *[!0-9]*) ;;
        *)
            [ "$BENCH_MAX_WORKER_PROCESSES" -ge "$BENCH_THREADS_TO" ] \
                || bench_fail "BENCH_MAX_WORKER_PROCESSES ($BENCH_MAX_WORKER_PROCESSES) must be at least BENCH_THREADS_TO ($BENCH_THREADS_TO)"
            ;;
    esac

    bench_require_identifier BENCH_SCHEMA "$BENCH_SCHEMA"
    bench_require_identifier BENCH_DB "$BENCH_DB"
    bench_require_identifier BENCH_OWNER_USER "$BENCH_OWNER_USER"
    bench_require_identifier BENCH_SOURCE_TABLE "$BENCH_SOURCE_TABLE"
    bench_require_identifier BENCH_TARGET_TABLE "$BENCH_TARGET_TABLE"
    bench_require_identifier BENCH_ORDERED_SOURCE_TABLE "$BENCH_ORDERED_SOURCE_TABLE"
    bench_require_identifier BENCH_ORDERED_TARGET_TABLE "$BENCH_ORDERED_TARGET_TABLE"
    bench_require_identifier BENCH_ORDERED_INDEX "$BENCH_ORDERED_INDEX"
    bench_require_identifier BENCH_PARTITIONED_SOURCE_TABLE "$BENCH_PARTITIONED_SOURCE_TABLE"
    bench_require_identifier BENCH_PARTITIONED_TARGET_TABLE "$BENCH_PARTITIONED_TARGET_TABLE"
    bench_require_identifier BENCH_PARTITIONED_ORDERED_SOURCE_TABLE "$BENCH_PARTITIONED_ORDERED_SOURCE_TABLE"
    bench_require_identifier BENCH_PARTITIONED_ORDERED_TARGET_TABLE "$BENCH_PARTITIONED_ORDERED_TARGET_TABLE"
    bench_require_identifier BENCH_PARTITIONED_ORDERED_INDEX "$BENCH_PARTITIONED_ORDERED_INDEX"

    bench_require_template BENCH_SQL "$BENCH_SQL"
    bench_require_template BENCH_PARTITIONED_SQL "$BENCH_PARTITIONED_SQL"
    bench_require_template BENCH_ORDERED_SQL "$BENCH_ORDERED_SQL"
    bench_require_template BENCH_PARTITIONED_ORDERED_SQL "$BENCH_PARTITIONED_ORDERED_SQL"

    _bench_result=0
    [ "$_bench_invalid" -eq 0 ] || _bench_result=1
    unset _bench_template _bench_count _bench_invalid
    return "$_bench_result"
}
