# https://maven.apache.org/tools/wrapper/#Usage_with_or_without_Binary_JAR
.mvn/wrapper/maven-wrapper.jar

# Eclipse m2e generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
# JDT per-project preferences and its default output folder. Eclipse writes
# these inside each project directory (for example dml_utils/.settings/), not at
# the repository root, so match them at any depth.
.settings/
bin/

# IntelliJ
.idea/
*.iml
out/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# OS / editor noise
.DS_Store
*.log

# Local secrets
.env
.env.*
!.env.example
# The committed root .env holds only non-secret dev-stack config (HOST_PORT)
# for the shared compose.yaml; the Secret Scan (gitleaks) workflow scans it on
# every PR and push, so a secret added there fails CI. Nested .env files stay
# ignored; keep secrets in the environment or a local, ignored file.
!/.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Beads / Dolt files
.beads/
.dolt/
.beads-credential-key

# Benchmark personal overrides (see benchmark/README.md)
benchmark/config.local.env
