<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The migration_run ordered-key shape check, in its original form and as
         widened for bytea. Changesets 009 and 010 and 009's rollback expand these
         into their SQL files, so the expression is written once and cannot drift
         between them. Quotes are doubled because the expression is passed to the
         ddl_utils helpers as a string literal. -->
    <property name="ordered_key_shape_check_expression"
              value="ordered_key_columns IS NULL
        OR (pg_catalog.cardinality(ordered_key_columns) BETWEEN 1 AND 3
        AND pg_catalog.cardinality(ordered_key_kinds)
                = pg_catalog.cardinality(ordered_key_columns)
        AND ordered_key_kinds &lt;@ ARRAY [''bigint'', ''text'', ''uuid'', ''timestamptz'', ''bytea'']::text[])"/>
    <property name="ordered_key_shape_check_expression_before_bytea"
              value="ordered_key_columns IS NULL
        OR (pg_catalog.cardinality(ordered_key_columns) BETWEEN 1 AND 3
        AND pg_catalog.cardinality(ordered_key_kinds)
                = pg_catalog.cardinality(ordered_key_columns)
        AND ordered_key_kinds &lt;@ ARRAY [''bigint'', ''text'', ''uuid'', ''timestamptz'']::text[])"/>

    <changeSet id="001-create-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/001-create-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/001-create-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-lib-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/002-create-lib-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/002-create-lib-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="003-create-data-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/003-create-data-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/003-create-data-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Domains must exist before any routine that types its arguments with
         them, so create them before the functions include. -->
    <changeSet id="004-create-domains" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/004-create-domains.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/004-create-domains-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Adds the bytea array to the migration_key type created above. It is
         listed here, not at the end, because the boundary-key check helper
         below reads the new attribute, so a database built from scratch needs it
         before that helper is created. A database upgraded from an earlier
         release runs it on its own first, then re-applies the helper. -->
    <changeSet id="008-add-bytea-key-kind" author="hellblazer" dbms="postgresql">
        <!-- 008 commits on its own, and a database that has the fifth attribute
             but not the routines that build it breaks in every new backend, so
             this changeset must not run unless 009 and 010 can. They call the
             ddl_utils helpers: halt here, before anything changes, when the
             schema is missing or the migrating role cannot execute them. This
             is the one place a changeset carries SQL in the XML; Liquibase has
             no file form of a precondition. -->
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="1">
                SELECT CASE
                    WHEN pg_catalog.to_regnamespace('ddl_utils') IS NULL THEN 0
                    WHEN NOT pg_catalog.has_schema_privilege(pg_catalog.current_user(), 'ddl_utils', 'USAGE') THEN 0
                    WHEN (SELECT pg_catalog.count(DISTINCT p.proname)
                          FROM pg_catalog.pg_proc AS p
                                   JOIN pg_catalog.pg_namespace AS n ON n.oid = p.pronamespace
                          WHERE n.nspname = 'ddl_utils'
                            AND p.proname IN ('drop_constraint', 'add_check_constraint',
                                              'ensure_check_constraint')
                            AND pg_catalog.has_function_privilege(pg_catalog.current_user(), p.oid, 'EXECUTE')) = 3
                        THEN 1
                    ELSE 0
                END
            </sqlCheck>
        </preConditions>
        <sqlFile path="sql_changes/008-add-bytea-key-kind.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/008-add-bytea-key-kind-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The boundary-key check helper. It needs only the migration_key type
         (created above), so it is defined before the table whose CHECK calls
         it. -->
    <changeSet id="005-create-migration-key-check" author="lee.horner" dbms="postgresql"
               runOnChange="true">
        <sqlFile path="sql_changes/005-create-migration-key-check.sql"
                 relativeToChangelogFile="true" splitStatements="false"/>
        <rollback>
            <sqlFile path="rollback/005-create-migration-key-check-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The migration tables, including the partial index on
         migration_boundary's pending rows. No triggers yet: the tables do not
         depend on any routine, and the routines below reference them, so the
         tables come first. The index is part of the table changeset, so it is a
         plain CREATE INDEX: the table is new, so there is no completed prefix to
         block and no need for CONCURRENTLY. -->
    <changeSet id="006-create-migration-tables" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/006-create-migration-tables.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/006-create-migration-tables-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Lets a run record bytea as an ordered-key kind. It replaces a check on
         migration_run, so it follows the table's own changeset, and it calls
         the ddl_utils helpers. The new check is added NOT VALID here and
         validated by the next changeset. -->
    <changeSet id="009-allow-bytea-ordered-key-kind" author="hellblazer" dbms="postgresql">
        <sqlFile path="sql_changes/009-allow-bytea-ordered-key-kind.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/009-allow-bytea-ordered-key-kind-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Validates the check the previous changeset added NOT VALID. The
         ddl_utils procedure commits between steps, so it runs outside a
         transaction and is this changeset's only statement. -->
    <changeSet id="010-validate-ordered-key-shape-check" author="hellblazer" dbms="postgresql"
               runInTransaction="false">
        <sqlFile path="sql_changes/010-validate-ordered-key-shape-check.sql"
                 relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/010-validate-ordered-key-shape-check-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Revoke PUBLIC's default EXECUTE/USAGE on future objects before any
         routine or type is created, so a newly added object cannot be
         world-executable even if it is omitted from 999-grant-privileges. -->
    <changeSet id="007-default-privileges" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/007-default-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/007-default-privileges-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Stored routines: one changeset each, one file per routine. They run
         after the tables so routines may reference them. -->
    <include file="functions.xml" relativeToChangelogFile="true"/>

    <!-- The tables' triggers, one per file. They call the routines defined
         above, so they run after the functions include. -->
    <include file="triggers.xml" relativeToChangelogFile="true"/>

    <!-- A single, re-runnable changeset for all caller grants. runOnChange
         makes Liquibase re-apply it whenever this SQL changes, so new grants
         reach existing databases. Keep the statements idempotent. -->
    <changeSet id="999-grant-privileges" author="lee.horner" dbms="postgresql" runOnChange="true">
        <sqlFile path="sql_changes/999-grant-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/999-grant-privileges-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
