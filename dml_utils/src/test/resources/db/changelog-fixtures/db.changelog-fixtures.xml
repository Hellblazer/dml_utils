<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="fixture-001-create-schema" author="lee.horner">
        <!-- The schema may already exist after a lost Liquibase history. A plain
             CREATE SCHEMA IF NOT EXISTS still checks the database CREATE
             privilege, which the applying role may not have on a test clone, so
             skip the changeset instead of attempting it. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM pg_catalog.pg_namespace
                WHERE nspname = 'dml_utils_fixtures'
            </sqlCheck>
        </preConditions>
        <sqlFile path="changes/001-create-fixture-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="changes/rollback/001-create-fixture-schema-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="fixture-002-create-tables" author="lee.horner">
        <sqlFile path="changes/002-create-fixture-tables.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="changes/rollback/002-create-fixture-tables-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="fixture-003-grant" author="lee.horner">
        <sqlFile path="changes/003-grant-fixtures.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="changes/rollback/003-grant-fixtures-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
