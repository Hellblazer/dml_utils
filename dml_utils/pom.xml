<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.eyupmiduck</groupId>
        <artifactId>dml-utils-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>dml_utils</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <!-- jOOQ references JAXB annotations but declares the API as optional.
             Provided scope puts it on the compile classpath (so javac can
             resolve the annotations) without adding a runtime requirement. -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SLF4J binding for the Testcontainers logging (see the parent POM). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ddl_utils is resolved by the maven-dependency-plugin unpack (version
             property `ddl-utils.version`) rather than declared as a test
             dependency: the jar also contains db/changelog/**, which would
             collide with this project's changelog on the test classpath. -->
        <dependency>
            <groupId>io.github.eyupmiduck</groupId>
            <artifactId>liquibase-validation</artifactId>
            <version>${liquibase-validation.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Shared test support (PostgresTestBase, ChangelogTestSupport, the
             assertion helpers). test-jar dependencies are not transitive, so
             the test-scoped JUnit/Testcontainers/jOOQ/liquibase-core the support
             needs are declared above. -->
        <dependency>
            <groupId>io.github.eyupmiduck</groupId>
            <artifactId>liquibase-validation</artifactId>
            <version>${liquibase-validation.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Stage the install-only changelog into target/classes before jOOQ
                 codegen runs. The codegen and the upgrade test read changelogs
                 through a ClassLoaderResourceAccessor, so the tree must be on
                 the build classpath. process-resources copies
                 src/main/resources again later. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-install-changelog</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Unpack the changelog from the versioned ddl_utils artifact
                 instead of reading a git submodule. It lands at
                 db/changelog-install/ddl-utils/db/changelog/, matching the
                 install changelog's include path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-ddl-utils-changelog</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.github.eyupmiduck</groupId>
                                    <artifactId>ddl_utils</artifactId>
                                    <version>${ddl-utils.version}</version>
                                    <includes>db/changelog/**</includes>
                                    <outputDirectory>${project.build.outputDirectory}/db/changelog-install/ddl-utils
                                    </outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The install changelog and the unpacked ddl_utils changelog are
                 test/codegen-only; the published jar must not bundle ddl_utils. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>db/changelog-install/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- jOOQ codegen against a real PostgreSQL container built from the
                 custom image (roles baked in), migrated with Liquibase as the
                 image superuser so the install changelog can create the
                 ddl_utils role. Requires a
                 running Docker daemon and the custom image built first; this is
                 intentional (no offline/H2 simulation), so `verify` and any other
                 lifecycle that reaches codegen need Docker. Prebuilt generated
                 sources can be reused by adding
                 -Dtestcontainers.jooq.codegen.skip=true, which is only for
                 environments that already have target/generated-sources/jooq. -->
            <plugin>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                <dependencies>
                    <!-- Override the plugin's bundled Testcontainers 1.19.1 so
                         the codegen runs the same Testcontainers as the tests. -->
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers-postgresql</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <!-- Override the plugin's bundled jOOQ 3.18.3: it cannot read
                         PostgreSQL 17 catalogs (key_seq error during codegen). -->
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <!-- Skip switch for environments that already have
                                 generated sources; see the plugin comment. -->
                            <skip>${testcontainers.jooq.codegen.skip}</skip>
                            <database>
                                <type>POSTGRES</type>
                                <containerImage>${postgres.image}</containerImage>
                                <!-- A superuser, so the install changelog can
                                     create ddl_utils_caller for ddl_utils'
                                     grants; the generated schema shape does not
                                     depend on ownership. -->
                                <username>postgres</username>
                                <password>postgres</password>
                                <databaseName>dml_utils</databaseName>
                            </database>
                            <liquibase>
                                <changeLogPath>db/changelog-install/db.changelog-install.xml</changeLogPath>
                                <changeLogDirectory>target/classes</changeLogDirectory>
                                <!-- Keep Liquibase's tracking tables out of the
                                     application schemas: a dedicated `liquibase`
                                     schema with dml_utils-prefixed tables. The
                                     schema is created by the custom image's init
                                     script (Liquibase does not create it). -->
                                <liquibaseSchemaName>liquibase</liquibaseSchemaName>
                                <databaseChangeLogTableName>dml_utils_databasechangelog</databaseChangeLogTableName>
                                <databaseChangeLogLockTableName>dml_utils_databasechangeloglock
                                </databaseChangeLogLockTableName>
                            </liquibase>
                            <jooq>
                                <generator>
                                    <database>
                                        <includes>.*</includes>
                                        <!-- jOOQ 3.21 cannot model a domain over
                                             an array: it generates a Domain<T[]>
                                             backed by SQLDataType.OTHER, which
                                             does not compile. Exclude the handle
                                             array domains; the routine that takes
                                             them falls back to Object parameters
                                             (as ddl_utils does for its array
                                             domains). -->
                                        <excludes>.*non_null_element_.*_array</excludes>
                                        <!-- jOOQ cannot combine several
                                             schemata in one <inputSchema>;
                                             each schema maps to its own
                                             subpackage (dml_utils,
                                             dml_utils_lib). -->
                                        <schemata>
                                            <schema>
                                                <inputSchema>dml_utils</inputSchema>
                                            </schema>
                                            <schema>
                                                <inputSchema>dml_utils_lib</inputSchema>
                                            </schema>
                                            <schema>
                                                <inputSchema>dml_utils_data</inputSchema>
                                            </schema>
                                        </schemata>
                                    </database>
                                    <target>
                                        <packageName>io.github.eyupmiduck.dmlutils.jooq</packageName>
                                        <directory>target/generated-sources/jooq</directory>
                                    </target>
                                    <generate>
                                        <!-- jOOQ's per-schema UDTs convenience
                                             class calls the UDT's static factory
                                             through the static instance field
                                             (MIGRATION_KEY.MIGRATION_KEY(...)),
                                             which javac flags as a static-method
                                             call via an expression; with -Werror
                                             that fails the build. The UDT type and
                                             record are still generated; only the
                                             convenience facade is skipped. -->
                                        <globalUDTReferences>false</globalUDTReferences>
                                        <!-- A routine taking an excluded array
                                             domain has Object parameters of
                                             unknown type; marking them
                                             @Deprecated would fail the -Werror
                                             build when tests call them. -->
                                        <deprecationOnUnknownTypes>false</deprecationOnUnknownTypes>
                                    </generate>
                                </generator>
                            </jooq>
                        </configuration>
                    </execution>

                    <!-- Test-only fixtures: generate jOOQ classes for the tables
                         the integration tests drive the routines over, from the
                         fixture changelog in src/test/resources. Bound to
                         generate-test-sources so the classes compile into
                         target/test-classes (and not the published jar). -->
                    <execution>
                        <id>generate-jooq-fixtures</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-test-sources</phase>
                        <configuration>
                            <!-- Same skip switch as generate-jooq-sources. -->
                            <skip>${testcontainers.jooq.codegen.skip}</skip>
                            <database>
                                <type>POSTGRES</type>
                                <containerImage>${postgres.image}</containerImage>
                                <username>dml_utils_owner</username>
                                <password>dml_utils_owner</password>
                                <databaseName>dml_utils</databaseName>
                            </database>
                            <liquibase>
                                <changeLogPath>src/test/resources/db/changelog-fixtures/db.changelog-fixtures.xml
                                </changeLogPath>
                                <liquibaseSchemaName>liquibase</liquibaseSchemaName>
                                <databaseChangeLogTableName>dml_utils_databasechangelog</databaseChangeLogTableName>
                                <databaseChangeLogLockTableName>dml_utils_databasechangeloglock
                                </databaseChangeLogLockTableName>
                            </liquibase>
                            <jooq>
                                <generator>
                                    <database>
                                        <includes>.*</includes>
                                        <schemata>
                                            <schema>
                                                <inputSchema>dml_utils_fixtures</inputSchema>
                                            </schema>
                                        </schemata>
                                    </database>
                                    <target>
                                        <packageName>io.github.eyupmiduck.dmlutils.jooqfixtures</packageName>
                                        <directory>target/generated-test-sources/jooq</directory>
                                    </target>
                                </generator>
                            </jooq>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The fixture codegen adds its target as a compile source root;
                 register it as a *test* source too so it compiles into
                 target/test-classes (after the main compile has run). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <!-- Register the main jOOQ output explicitly. The codegen
                         plugin adds it when it runs, but IntelliJ's Maven
                         importer needs the source root in the project model to
                         pick it up reliably on reload. -->
                    <execution>
                        <id>add-jooq-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>target/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-jooq-fixtures-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>target/generated-test-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SQLFluff lints the Liquibase .sql files. Defaults to sqlfluff on
                 PATH; point it at the repo's .venv with
                 -Dsqlfluff.executable=$PWD/.venv/bin/sqlfluff. Skip with
                 -Dskip.sqlfluff. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>sqlfluff-lint</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${sqlfluff.executable}</executable>
                            <arguments>
                                <argument>lint</argument>
                                <argument>src/main/resources/db/changelog</argument>
                            </arguments>
                            <skip>${skip.sqlfluff}</skip>
                        </configuration>
                    </execution>
                    <!-- Runs the Liquibase changelog linter (rules that need both
                         the SQL and the changeset attributes, which SQLFluff cannot
                         see). It reads the changelog directory, the per-module
                         .liquibase-linter.yml and the accepted findings in
                         .liquibase-linter-whitelist.yml. Runs on the test
                         classpath because liquibase-validation is a test-scope
                         dependency; the plugin blocks the CLI's System.exit so a
                         finding fails the build instead of killing Maven. Skip
                         with -Dskip.liquibase-linter. -->
                    <execution>
                        <id>liquibase-linter</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.github.eyupmiduck.changelogvalidator.linter.cli.LinterCli</mainClass>
                            <classpathScope>test</classpathScope>
                            <blockSystemExit>true</blockSystemExit>
                            <arguments>
                                <argument>--changelog-root</argument>
                                <argument>${project.basedir}/src/main/resources/db/changelog</argument>
                                <argument>--config</argument>
                                <argument>${project.basedir}/.liquibase-linter.yml</argument>
                                <argument>--whitelist</argument>
                                <argument>${project.basedir}/.liquibase-linter-whitelist.yml</argument>
                                <argument>--fail-on</argument>
                                <argument>error</argument>
                            </arguments>
                            <skip>${skip.liquibase-linter}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Pass the PostgreSQL image and the current version to tests so
                 they use the same version as jOOQ codegen and can resolve the
                 previous release below it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <postgres.image>${postgres.image}</postgres.image>
                        <upgrade.current.version>${revision}</upgrade.current.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
